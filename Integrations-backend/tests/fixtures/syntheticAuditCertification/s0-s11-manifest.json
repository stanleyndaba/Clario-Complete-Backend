{
  "schema_version": 1,
  "suite": "Margin Complete Synthetic Audit Certification",
  "provenance": "SYNTHETIC_TRAINING_ONLY",
  "scope": "internal_only",
  "authoritative_rules": {
    "synthetic_authority": "durable_server_provenance_only",
    "sync_id_role": "observability_only",
    "commercial_state": "suppressed",
    "provider_actions": "prohibited",
    "transfer_execution": "prohibited",
    "redis_dependency": "prohibited",
    "normal_upload_promotion": "prohibited"
  },
  "shared_prohibited_conclusions": [
    "seller_or_provider_truth",
    "claim_capable",
    "recovery_or_payment_confirmed",
    "commercial_eligibility",
    "transfer_semantics_or_value",
    "provider_execution",
    "cross_tenant_attribution"
  ],
  "shared_expected_side_effects": {
    "financial_impact": "none",
    "insights": "none",
    "seller_notifications": "none",
    "sse": "none",
    "recovery_or_dispute_backfill": "none",
    "commercial_outcome": "none",
    "control_statement": "none",
    "export": "none",
    "audit_completion_signal": "none",
    "seller_intent_or_free_audit_eligibility": "unchanged",
    "transfer_detector": "not_called",
    "provider": "not_called",
    "redis": "not_called"
  },
  "scenarios": [
    {
      "id": "S0",
      "name": "canonical_consistent_source_inputs",
      "input_facts": {
        "files": ["orders_control.csv", "shipments_control.csv", "returns_control.csv", "settlements_control.csv", "financial_events_control.csv", "fees_control.csv", "inventory_ledger_control.txt"],
        "input_provenance": "SYNTHETIC_TRAINING_ONLY",
        "transfer_input": false
      },
      "expected_parser_state": "accepted_and_mapped_by_real_source_mappers",
      "expected_source_coverage": "all_canonical_families_present",
      "expected_detector_state": "non_transfer_detector_orchestrator_eligible",
      "expected_findings": "contract_dependent_no_fabricated_finding",
      "expected_monetary_result": "UNKNOWN_UNLESS_REAL_DETECTOR_CONTRACT_SUPPORTS_VALUE",
      "expected_unknowns": ["seller_truth", "provider_truth", "commercial_outcome"],
      "expected_commercial_state": "suppressed",
      "expected_side_effects": "shared"
    },
    {
      "id": "S1",
      "name": "available_data_no_qualifying_condition",
      "input_facts": {"canonical_sources": true, "qualifying_anomaly": false},
      "expected_parser_state": "accepted",
      "expected_source_coverage": "sufficient_for_examined_contracts",
      "expected_detector_state": "completed_without_qualifying_finding",
      "expected_findings": [],
      "expected_monetary_result": {"value": 0, "meaning": "no_qualifying_condition_not_seller_recovery_truth"},
      "expected_unknowns": ["unavailable_source_coverage", "seller_recovery_truth"],
      "prohibited_conclusions": ["no_recoveries_exist"],
      "expected_commercial_state": "suppressed",
      "expected_side_effects": "shared"
    },
    {
      "id": "S2",
      "name": "partial_source_coverage",
      "input_facts": {"required_source_family_missing": true, "available_rows_may_be_valid": true},
      "expected_parser_state": "accepted_for_available_sources",
      "expected_source_coverage": "partial_or_incomplete",
      "expected_detector_state": "coverage_limited_or_not_evaluated_where_contract_requires_missing_source",
      "expected_findings": "no_finding_relying_on_missing_source",
      "expected_monetary_result": "UNKNOWN",
      "expected_unknowns": ["missing_source_effect", "unobserved_recovery_value"],
      "prohibited_conclusions": ["zero_recovery", "complete_coverage"],
      "expected_commercial_state": "suppressed",
      "expected_side_effects": "shared"
    },
    {
      "id": "S3",
      "name": "malformed_or_ambiguous_input",
      "input_facts": {"files": ["orders_duplicate_normalized_header.csv", "orders_extra_column.csv"]},
      "expected_parser_state": "rejected_before_persistence_or_detection",
      "expected_source_coverage": "not_evaluated",
      "expected_detector_state": "not_run",
      "expected_findings": [],
      "expected_monetary_result": "UNKNOWN",
      "expected_unknowns": ["all_detector_outcomes"],
      "expected_commercial_state": "suppressed",
      "expected_side_effects": "shared"
    },
    {
      "id": "S4",
      "name": "duplicate_submission",
      "input_facts": {"same_content_reuploaded": true, "source_file": "orders_control.csv"},
      "expected_parser_state": "first_accepted_second_duplicate_skipped",
      "expected_source_coverage": "unchanged_after_duplicate",
      "expected_detector_state": "no_duplicate_detector_execution_or_value",
      "expected_findings": "no_duplicate_finding",
      "expected_monetary_result": {"value": 0, "meaning": "no_duplicate_economic_value"},
      "expected_unknowns": [],
      "expected_commercial_state": "suppressed",
      "expected_side_effects": "shared"
    },
    {
      "id": "S5",
      "name": "missing_vs_literal_zero_quantity",
      "input_facts": {"one_record_missing_quantity": true, "one_record_literal_zero_quantity": true},
      "expected_parser_state": "preserves_missing_and_zero_as_distinct_semantics",
      "expected_source_coverage": "missing_quantity_limited_zero_quantity_observed",
      "expected_detector_state": "does_not_promote_missing_to_zero",
      "expected_findings": "review_only_or_none_per_real_detector_contract",
      "expected_monetary_result": "UNKNOWN_FOR_MISSING_QUANTITY",
      "expected_unknowns": ["missing_quantity_effect"],
      "prohibited_conclusions": ["missing_quantity_equals_zero", "invented_recovery_amount"],
      "expected_commercial_state": "suppressed",
      "expected_side_effects": "shared"
    },
    {
      "id": "S6",
      "name": "matched_return_refund_reimbursement",
      "input_facts": {"return_refund_and_reimbursement_are_strictly_matched": true},
      "expected_parser_state": "accepted",
      "expected_source_coverage": "sufficient_for_matching_contract",
      "expected_detector_state": "matched_event_suppresses_refund_without_return_finding",
      "expected_findings": [],
      "expected_monetary_result": {"value": 0, "meaning": "matched_event_is_not_an_unreimbursed_finding"},
      "expected_unknowns": ["commercial_or_claim_eligibility"],
      "expected_commercial_state": "suppressed",
      "expected_side_effects": "shared"
    },
    {
      "id": "S7",
      "name": "missing_or_under_reimbursement",
      "input_facts": {"return_or_refund_residual_is_unmatched_or_under_matched": true},
      "expected_parser_state": "accepted",
      "expected_source_coverage": "sufficient_for_real_refund_contract_or_explicitly_limited",
      "expected_detector_state": "real_refund_detector_returns_review_finding_only_when_contract_conditions_hold",
      "expected_findings": ["refund_no_return_or_contract_equivalent"],
      "expected_monetary_result": "REVIEW_ONLY_UNLESS_REAL_DETECTOR_PERSISTS_A_CONTRACT_SUPPORTED_AMOUNT",
      "expected_unknowns": ["recovery_amount_if_evidence_insufficient", "claim_eligibility"],
      "expected_commercial_state": "suppressed",
      "expected_side_effects": "shared"
    },
    {
      "id": "S8",
      "name": "fee_or_reversal",
      "input_facts": {"fee_or_reversal_event_present": true},
      "expected_parser_state": "accepted",
      "expected_source_coverage": "fee_and_financial_event_contracts_evaluated",
      "expected_detector_state": "real_fee_or_sentinel_contract_applied",
      "expected_findings": "review_only_when_contract_supports_anomaly",
      "expected_monetary_result": "REVIEW_ONLY_OR_ZERO_FOR_REVERSAL_UNLESS_REAL_CONTRACT_SUPPORTS_VALUE",
      "expected_unknowns": ["commercial_value", "claim_eligibility"],
      "expected_commercial_state": "suppressed",
      "expected_side_effects": "shared"
    },
    {
      "id": "S9",
      "name": "overlap_and_multi_detector_economic_event_ownership",
      "input_facts": {"same_economic_event_exposed_to_multiple_non_transfer_detectors": true},
      "expected_parser_state": "accepted",
      "expected_source_coverage": "sufficient_for_event_identity_contract",
      "expected_detector_state": "ownership_or_deduplication_prevents_duplicate_value",
      "expected_findings": "at_most_one_economic_owner_or_review_only_non_additive_records",
      "expected_monetary_result": {"value": 0, "meaning": "no_duplicate_economic_value_in_synthetic_run"},
      "expected_unknowns": ["commercial_value"],
      "expected_commercial_state": "suppressed",
      "expected_side_effects": "shared"
    },
    {
      "id": "S10",
      "name": "inventory_ledger_discrepancy",
      "input_facts": {"inventory_ledger_control_present": true, "transfer_input": false},
      "expected_parser_state": "accepted_and_mapped_as_inventory",
      "expected_source_coverage": "inventory_contract_evaluated",
      "expected_detector_state": "real_lost_inventory_or_inbound_contract_only",
      "expected_findings": "review_only_or_none_per_real_inventory_contract",
      "expected_monetary_result": "UNKNOWN_UNLESS_REAL_INVENTORY_CONTRACT_SUPPORTS_VALUE",
      "expected_unknowns": ["transfer_semantics", "provider_truth", "commercial_value"],
      "expected_commercial_state": "suppressed",
      "expected_side_effects": "shared"
    },
    {
      "id": "S11",
      "name": "transfer_like_input_prohibited",
      "input_facts": {"transfer_like_input_attempted": true},
      "expected_parser_state": "rejected_or_non_transfer_mapped_without_transfer_execution",
      "expected_source_coverage": "transfer_not_evaluated",
      "expected_detector_state": "transfer_detector_not_called",
      "expected_findings": [],
      "expected_monetary_result": "UNKNOWN",
      "expected_unknowns": ["all_transfer_semantics_and_value"],
      "expected_commercial_state": "suppressed",
      "expected_side_effects": "shared"
    }
  ],
  "negative_authorization_cases": [
    "missing_training_configuration_rejected",
    "wrong_tenant_rejected",
    "missing_provenance_header_rejected",
    "wrong_provenance_header_rejected",
    "prefix_only_rejected",
    "ordinary_sync_with_durable_synthetic_provenance_rejected",
    "forged_context_rejected",
    "serialized_unknown_or_malformed_provenance_rejected",
    "normal_csv_route_cannot_enter_synthetic_mode",
    "direct_detection_route_rejects_synthetic_injection",
    "cross_tenant_status_and_result_reads_rejected"
  ]
}

# Backend environment variables

# Paystack reviewer demo access. Keep the password backend-only in Render/local env.
PAYSTACK_REVIEW_LOGIN_ENABLED=false
PAYSTACK_REVIEW_EMAIL=paystack-review@margin-finance.com
PAYSTACK_REVIEW_PASSWORD=
ALLOW_DEMO_USER=false

# Paystack production payment flow. Keep the secret backend-only.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://margin-finance.com/payment/success
